<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.move.mapper.CarMoveMapper">

    <resultMap id="BaseResultMap" type="com.example.move.pojo.CarMove">
            <id property="carId" column="car_id" jdbcType="INTEGER"/>
            <result property="carName" column="car_name" jdbcType="VARCHAR"/>
            <result property="carNumber" column="car_number" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        car_id,car_name,car_number,
        car_image
    </sql>
    <select id="queryCarByCarId" resultMap="BaseResultMap">
        select * from car_move where car_id = #{carId}
    </select>
</mapper>
