<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.move.mapper.CarProjectMapper">

    <resultMap id="BaseResultMap" type="com.example.move.pojo.CarProject">
            <id property="carId" column="car_id" jdbcType="INTEGER"/>
            <result property="projectId" column="project_id" jdbcType="INTEGER"/>
            <result property="carStartTime" column="car_start_time" jdbcType="DATE"/>
            <result property="carEndTime" column="car_end_time" jdbcType="DATE"/>
            <result property="carPersonalId" column="car_personal_id" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        car_id,project_id,car_start_time,
        car_end_time,car_personal_id
    </sql>
    <select id="queryCarByProId" resultMap="BaseResultMap">
        select * from car_project where project_id = #{proId}
    </select>
</mapper>
