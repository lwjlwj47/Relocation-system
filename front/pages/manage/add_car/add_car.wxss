/* pages/manage/add_car/add_car.wxss */
page{
	background-color:rgba(187, 194, 193, 0.493);
}
.container
{
	margin: 12rpx 24rpx 0 24rpx;
	padding: 0;
	background-color: rgba(255, 255, 255, 1);
}
.car
{
	margin-top: 12rpx;
	margin-bottom: 12rpx;
}
.car-name
{
	display: flex;
	flex-direction: row;
	padding: 24rpx;
}
.car-name-1
{
	font-size: 16px;
	font-weight: 700;
	letter-spacing: 0px;
	line-height: 22.4px;
	color: rgba(51, 51, 51, 1);
	text-align: left;
	vertical-align: top;
	margin-bottom: 18rpx;
}
.car-time
{
	border-radius: 2px;
	background: rgba(245, 245, 245, 1);
	display: flex;
	justify-content: flex-start;
	align-items: flex-start;
	padding: 1px 6px 1px 6px;
	font-size: 12px;
	font-weight: 400;
	letter-spacing: 0px;
	line-height: 16.8px;
	color: rgba(51, 51, 51, 1);
	text-align: left;
	vertical-align: top;
}
.car-info
{
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	padding: 24rpx;
}
.remark
{
	font-size: 12px;
	font-weight: 400;
	letter-spacing: 0px;
	line-height: 16.8px;
	color: rgba(153, 153, 153, 1);
	vertical-align: top;
}
.box
{
	height: 108rpx;
	display: flex;
	justify-content: center;
	flex-direction: column;
	flex:1 1 auto;
	text-align: center;
}
.select
{
	display: flex;
	flex-direction: row-reverse;
}
.search{
	padding: 0rpx 24rpx 0rpx 24rpx;
	background-color: rgba(255, 255, 255, 1);
}