/* pages/firstparty/equipment/equipment.wxss */
page{
	background-color:rgba(187, 194, 193, 0.493);
}
.container
{
	margin: 12rpx 24rpx 0 24rpx;
	padding: 0;
}
.car
{
	border-radius: 10rpx;
	background-color: rgba(255, 255, 255, 1);
	margin: 12rpx 24rpx 12rpx 24rpx;
	width: 702rpx;
}
.room-number
{
	width: 160rpx;
	height: 42rpx;
	opacity: 1;
	position: right;
	border-radius: 0px 5px, 0px, 5px;
	background: rgba(0, 133, 254, 1);
	font-size: 12px;
	font-weight: 400;
	letter-spacing: 0px;
	line-height: 16.8px;
	color: rgba(255, 255, 255, 1);
	text-align: center;
	vertical-align: top;
}
.equipment-name
{
	display: flex;
	flex-direction: row;
	margin: 20rpx 32rpx 16rpx 32rpx;
}
.equipment-name-1
{
	font-size: 16px;
	font-weight: 700;
	letter-spacing: 0px;
	line-height: 22.4px;
	color: rgba(51, 51, 51, 1);
	text-align: left;
	vertical-align: top;
}
.number-container
{
	display: flex;
	flex-direction: row-reverse;
}
.rank
{
	height: 40rpx !important;
	width: 96rpx !important;
	border-radius: 0rpx !important;
	margin-top: 16rpx;
	margin-bottom: 26rpx;
}
.person
{
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	width: 448rpx;
}
.person-1
{
	font-size: 12px;
	font-weight: 400;
	letter-spacing: 0px;
	line-height: 16.8px;
	color: rgba(153, 153, 153, 1);
	text-align: left;
	vertical-align: top;
}
.person-2
{
	font-size: 12px;
	font-weight: 400;
	letter-spacing: 0px;
	line-height: 16.8px;
	color: rgba(51, 51, 51, 1);
	text-align: left;
	vertical-align: top;
}
.remark
{
	margin: 16rpx 0 24rpx 32rpx;
	font-size: 12px;
	font-weight: 400;
	letter-spacing: 0px;
	line-height: 16.8px;
	color: rgba(153, 153, 153, 1);
	text-align: left;
	vertical-align: top;
}
.remark-1
{
	font-size: 12px;
	font-weight: 400;
	letter-spacing: 0px;
	line-height: 16.8px;
	color: rgba(51, 51, 51, 1);
	text-align: left;
	vertical-align: top;
}