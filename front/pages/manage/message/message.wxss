/* pages/firstparty/message/message.wxss */
page{
	background-color:rgba(187, 194, 193, 0.493);
}
.container
{
	margin: 12rpx 12rpx 0 12rpx;
	padding: 0;
}
.card
{
	padding: 24rpx;
	margin: 12rpx 0 12rpx 0;
	background-color: rgba(255, 255, 255, 1);
	border-radius: 16rpx;
}
.top
{
	font-size: 16px;
	font-weight: 700;
	letter-spacing: 0px;
	line-height: 22.4px;
	color: rgba(51, 51, 51, 1);
	text-align: left;
	vertical-align: top;
}
.content
{
	font-size: 14px;
	font-weight: 400;
	letter-spacing: 0px;
	line-height: 19.6px;
	color: rgba(102, 102, 102, 1);
	text-align: left;
	vertical-align: top;
	padding-top: 20rpx;
	padding-bottom: 20rpx;

}
.time
{
	font-size: 11px;
	font-weight: 400;
	letter-spacing: 0px;
	line-height: 15.4px;
	color: rgba(153, 153, 153, 1);
	text-align: left;
	vertical-align: top;
}