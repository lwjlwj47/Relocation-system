<!--pages/manage/apply/apply.wxml-->
<t-tabs
  defaultValue="{{0}}"
  bind:change="onTabsChange"
  bind:click="onTabsClick"
  t-class="custom-tabs"
  t-class-content="custom-panel"
>
  <t-tab-panel label="通过" value="0" style="{{tabPanelstyle}}">
	<view wx:for="{{done}}" class="card" bind:tap="goto">
		<view class='l'>项目名称：{{item.name}}</view>
		<view class='l'>报销类型：{{item.type}}</view>
		<view class='l'>报销金额：{{item.money}}</view>
		<view class='l'>报销时间：{{item.time}}</view>
	</view>
	</t-tab-panel>
  <t-tab-panel label="待审查" value="1" style="{{tabPanelstyle}}">选项二内容</t-tab-panel>
</t-tabs>
