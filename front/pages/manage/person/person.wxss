/* pages/manage/person/person.wxss */
page{
	height: 100%;
	background-color:rgba(187, 194, 193, 0.493);
}
.search{
	padding: 0rpx 24rpx 0rpx 24rpx;
	background-color: azure;
}
.equipment-name
{
	display: flex;
	flex-direction: row;
	margin: 20rpx 32rpx 16rpx 32rpx;
	background-color: rgba(245, 245, 245, 1);
}
.info-container
{
	/* margin: 36rpx; */
	margin: 24rpx 0  24rpx 0;
}
.equipment-name-1
{
	font-size: 16px;
	font-weight: 700;
	letter-spacing: 0px;
	line-height: 22.4px;
	color: rgba(51, 51, 51, 1);
	text-align: left;
	vertical-align: top;
}
.number-container
{
	display: flex;
	flex-direction: row-reverse;
}
.rank
{
	height: 40rpx !important;
	width: 96rpx !important;
	border-radius: 0rpx !important;
	margin-top: 16rpx;
	margin-bottom: 26rpx;
}
.person
{
	width: 448rpx;
}
.person-1
{
	font-size: 12px;
	font-weight: 400;
	letter-spacing: 0px;
	line-height: 16.8px;
	color: rgba(153, 153, 153, 1);
	text-align: left;
	vertical-align: top;
}
.name 
{
	display: flex;
	flex-direction: row;
	justify-content: space-between;
}
.button
{
	position: fixed !important;
	bottom: 0;
	width: 100%;
	border-radius: 0rpx !important;
}
